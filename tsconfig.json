{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "api/**/*",
    "backend/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "backend/node_modules",
    "dist"
  ]
}
